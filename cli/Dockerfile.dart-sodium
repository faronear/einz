# einz 开发/运行用 dart 容器：dart:stable + libsodium（TUI FFI 运行时必需，
# 官方 dart:stable 镜像不带该系统库，dart run 会报"无法加载 libsodium"）。
#
# 注意：必须装 libsodium-dev（而非仅 libsodium23）——sodium FFI 探测的是
# 未版本化的 libsodium.so（/usr/lib/x86_64-linux-gnu/libsodium.so 等），
# 而 libsodium23 只提供带版本的 libsodium.so.23，缺 dev 包的符号链接
# 仍会报"无法加载 libsodium"。
#
# 构建（仓库根执行，一条命令）：
#   docker build -f cli/Dockerfile.dart-sodium -t dart-sodium cli/
# 升级 dart 后重建（先拉新版基础镜像再 --pull 重建）：
#   docker pull dart:stable && docker build --pull -f cli/Dockerfile.dart-sodium -t dart-sodium cli/
# 之后 ./cli/dart-docker.sh（setup/tui/dartc/build）会自动优先使用 dart-sodium 镜像
# （也可设 DART_IMAGE=<镜像> 覆盖）。

FROM dart:stable
RUN apt-get update \
  && apt-get install -y --no-install-recommends libsodium23 libsodium-dev \
  && rm -rf /var/lib/apt/lists/* \
  # 实际库路径随镜像架构变化（arm64 镜像在 aarch64-linux-gnu/，amd64 在 x86_64-linux-gnu/），
  # 硬编码 x86_64 会在 arm64 机器上产生悬空链接 → sodium.dart 三个候选路径全落空。
  # sodium.dart 探测的是 /usr/lib/libsodium.so 与 /usr/local/lib/libsodium.so 这两个
  # 架构无关路径，故用 shell 通配符定位真实的多架构库文件（dpkg-architecture 在
  # 精简镜像里不存在，不可用）：
  && ln -sf /usr/lib/*-linux-gnu/libsodium.so.23 /usr/local/lib/libsodium.so \
  && ln -sf /usr/lib/*-linux-gnu/libsodium.so.23 /usr/lib/libsodium.so
