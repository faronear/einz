<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- 用户经文件选择器挑中的文件：对话页的附件入口/换头像走 FilePicker.pickFiles。
	     沙盒下**必须显式声明**，否则 open panel 起不来、点了没反应（老板 2026-09-26
	     实测：本地 debug 构建里「My avatar」点击无反应，而 CI 的 Release 包正常——
	     就是这个差异：Release.entitlements 早就有这一项，DebugProfile 漏了）。 -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- 保存对话框（FilePicker.saveFile，长按菜单/气泡「保存」）：写用户选中的位置
	     需要 read-write（老板 2026-10-02 实测：只有 read-only 时 saveFile 弹
	     platformexception entitlement_required_write）。 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)cc.tic.einz</string>
	</array>
</dict>
</plist>
