# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# 本机本地开发配置（flutter run/build --dart-define-from-file 读取；不入 git——
# 覆盖 kEinzServer 等启动参数，模板见 localConfig.example.json）
/localConfig.*.json
!/localConfig.example.json
/localConfig.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# 签名密钥（禁止提交）
/android/key.properties

# 平台工程文件跟踪策略：macos/windows 桌面端构建依赖其工程文件，必须跟踪；
# 各自目录内有 .gitignore 精确排除本地产物。linux/web 暂不需要，继续忽略。
/linux/
/web/

# Widget Preview related
.widget_preview/

# golden 测试失败自动生成的比对产物（勿提交）
/test/failures/
