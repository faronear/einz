# Einz Caddy 配置：TLS 自动签发 + 反向代理 + WSS 升级
# 模板文件（Docker 与裸 node 两种部署形态通用）：
#   - Docker 部署：拷贝为 server/docker/Caddyfile（withcaddy compose 挂载它）再改域名；
#   - 裸 node 部署：照它配置系统级 /etc/caddy/Caddyfile。
# 把 private.example.com 替换为真实域名；Caddy 自动申请/续期证书。

private.example.com {
    reverse_proxy server:3000 # docker caddy: server, host caddy: 127.0.0.1

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
}
