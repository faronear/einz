# nodejs 不会默认，需要 npm run dev 显性指定使用本文件。
# docker 默认加载 context 里的 .env

EINZ_DB_BACKUP_KEY=

EINZ_SMTP_HOST=
EINZ_SMTP_PORT=587
EINZ_SMTP_USER=
EINZ_SMTP_PASS=
EINZ_MAIL_FROM='Einz <hi@tic.cc>'

# 服务端转写（本地 dev 调试，方案 D'，2026-10-22）：本机 whisper.cpp 编译产物 + ggml-small 模型。
# ⚠ 相对路径的基准是**进程 cwd**（npm run dev/start 恒为 server/），不是本文件位置——
#   所以这里写 models.nogit/...（= server/models.nogit/...），不是 ../models.nogit/...（那是 compose 卷语法，
#   卷路径才相对 server/docker/ 解析）。Docker 跑法不读这三个值（compose 硬编码容器内
#   /opt/... 路径），只影响裸 node。拿不准就用绝对路径。
EINZ_WHISPER_BIN=models.nogit/whisper.cpp/build/bin/whisper-cli
EINZ_WHISPER_MODEL=models.nogit/whisper.cpp/models/ggml-small.bin

# 只要设置好，优先级高于 whisper，`curl -s http://127.0.0.1:3000/health` 应见 "asr_engine":"sensevoice"
EINZ_SENSEVOICE_MODEL=models.nogit/sensevoice

# 转写引擎选择：sensevoice / whisper（不设=自动：sensevoice 配了优先，否则 whisper）
# Docker 跑法同样读这个值（compose 插值进容器）；裸 node 直接用宿主机路径。
# EINZ_ASR_ENGINE=whisper

# COMPOSE_PROFILES=caddy
# 中国双入口形态（系统级 Caddy 服备案域名 + cloudflared 隧道服境外域名）：
# COMPOSE_PROFILES=cftunnel
# 两个 profile 可组合（逗号分隔）：COMPOSE_PROFILES=caddy,cftunnel

# Cloudflare 隧道 token（cftunnel 形态必需；建隧道步骤见 docker-compose.yml 文件头）
# CF_TUNNEL_TOKEN=
